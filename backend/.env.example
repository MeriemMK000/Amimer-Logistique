DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fleet_manager
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h
PORT=3001

# Recherche d'adresse Google Maps (champs « lieu » : missions + demandes PEC).
# Console Google Cloud → activer l'API "Places API (New)" + la facturation, créer une clé API.
# Tant que la clé n'est pas renseignée (ou = valeur d'exemple), repli automatique sur OpenStreetMap.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# GEOCODING_ENABLED=false   # désactive tout géocodage externe (référentiel local uniquement)
